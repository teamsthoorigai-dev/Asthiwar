{
    "name": "asthiwar-web",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "backend",
        "database"
    ],
    "scripts": {
        "dev": "next dev",
        "dev:backend": "npm --workspace=backend run dev",
        "dev:web": "next dev",
        "build": "npm run build:database && npm run build:backend && npm run build:web",
        "build:backend": "npm --workspace=backend run build",
        "build:database": "npm --workspace=database run build",
        "build:web": "next build",
        "check-types": "npm --workspace=database run check-types && npm --workspace=backend run check-types && tsc --noEmit",
        "db:generate": "npm --workspace=database run db:generate",
        "db:migrate": "npm --workspace=database run db:migrate",
        "db:seed": "npm --workspace=database run db:seed",
        "start": "next start",
        "lint": "eslint",
        "test": "node scripts/test-pricing.js"
    },
    "dependencies": {
        "gsap": "^3.15.0",
        "lenis": "^1.3.26",
        "lucide-react": "^0.475.0",
        "next": "16.3.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.4",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
