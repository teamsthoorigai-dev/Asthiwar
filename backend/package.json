{
  "name": "@asthiwar/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "predev": "npm --workspace=@asthiwar/database run build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm --workspace=@asthiwar/database run build",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test:pdf": "tsx src/scripts/test_pdf.ts",
    "start": "node dist/server.js",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@asthiwar/database": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.19.1",
    "resend": "^6.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  }
}
