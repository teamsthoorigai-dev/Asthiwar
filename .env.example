# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS & Security
# Comma-separated list of allowed browser origins. Must be set to real production domain(s) before deploy.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Signs the trusted-device login cookie. Generate your own (openssl rand -hex 32): this example
# value is public, and the server refuses to start with it when NODE_ENV=production.
SESSION_SECRET=asthiwar-super-secret-development-session-key-change-in-production-min32chars

# Shared with the Next.js app (same variable there). When set on both, the frontend proxy
# forwards each visitor's IP so rate limits are per visitor, not per Vercel egress address.
# At least 32 characters. Leave unset locally.
# API_PROXY_SECRET=

# Proxies in front of the API (default 1: Render's load balancer, or the docker-compose web
# container — which is only sound with a reverse proxy in front of it; see docker-compose.yml).
# Set 0 if clients reach the API directly: trusting a proxy that is not there lets any caller
# forge X-Forwarded-For and pick their own rate-limit bucket.
# TRUST_PROXY_HOPS=1

# docker-compose only: the Postgres password, also used in the backend's DATABASE_URL there.
# Letters and digits only, since it is embedded in a URL.
# POSTGRES_PASSWORD=

# First admin account, created on the first start when there is none (the seed does the same).
# Without ADMIN_SEED_PASSWORD, production generates a random password and prints it once in the server
# log; development uses the default in database/src/admin-defaults.ts. An account still on that
# published default is moved onto ADMIN_SEED_PASSWORD when you set one and re-run the seed.
# ADMIN_SEED_EMAIL=admin@asthiwar.com
# ADMIN_SEED_PASSWORD=

# Database TLS. Certificates are verified for dotted hostnames (sslmode= in the URL takes precedence).
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Sender email. In testing/dev, use 'ASTHIWAR <onboarding@resend.dev>'. In production, use your verified domain.
RESEND_FROM_EMAIL="ASTHIWAR <onboarding@resend.dev>"
# Recipient address where you want to receive form submissions from the website
CONTACT_RECIPIENT_EMAIL=your_email@example.com
ADMIN_ALERT_EMAIL=contact@asthiwar.com

# WhatsApp Notification Configuration
# Target WhatsApp number with country code where you want alerts delivered (e.g. 919488440123)
WHATSAPP_RECIPIENT_PHONE=919488440123

# Server-Side WhatsApp Provider (Configure one of the following for automated background delivery):
# Option A: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: UltraMsg / Custom REST Gateway (https:// URLs only)
# WHATSAPP_API_URL=https://api.ultramsg.com/INSTANCE_ID/messages/chat
# WHATSAPP_API_TOKEN=your_ultramsg_token
