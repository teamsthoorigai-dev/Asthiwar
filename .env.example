# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS & Security
# Comma-separated list of allowed browser origins. Must be set to real production domain(s) before deploy.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SESSION_SECRET=asthiwar-super-secret-development-session-key-change-in-production-min32chars

# Shared with the Next.js app (same variable there). When set on both, the frontend proxy
# forwards each visitor's IP so rate limits are per visitor, not per Vercel egress address.
# At least 32 characters. Leave unset locally.
# API_PROXY_SECRET=

# First admin account, used by `npm run db:seed`. In production the seed refuses to create an
# account without ADMIN_SEED_PASSWORD, and replaces the published default on any account still using it.
# ADMIN_SEED_EMAIL=admin@asthiwar.com
# ADMIN_SEED_PASSWORD=

# Database TLS. Certificates are verified for dotted hostnames (sslmode= in the URL takes precedence).
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Sender email. In testing/dev, use 'ASTHIWAR <onboarding@resend.dev>'. In production, use your verified domain.
RESEND_FROM_EMAIL="ASTHIWAR <onboarding@resend.dev>"
# Recipient address where you want to receive form submissions from the website
CONTACT_RECIPIENT_EMAIL=your_email@example.com
ADMIN_ALERT_EMAIL=contact@asthiwar.com

# WhatsApp Notification Configuration
# Target WhatsApp number with country code where you want alerts delivered (e.g. 919488440123)
WHATSAPP_RECIPIENT_PHONE=919488440123

# Server-Side WhatsApp Provider (Configure one of the following for automated background delivery):
# Option A: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: UltraMsg / Custom REST Gateway
# WHATSAPP_API_URL=https://api.ultramsg.com/INSTANCE_ID/messages/chat
# WHATSAPP_API_TOKEN=your_ultramsg_token

# Option C: CallMeBot (Free personal WhatsApp bot)
# CALLMEBOT_API_KEY=your_callmebot_api_key
