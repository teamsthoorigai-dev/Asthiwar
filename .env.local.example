# -----------------------------------------------------------------------------
# ASTHIWAR Web Application Environment Configuration
# -----------------------------------------------------------------------------

# Browser-visible API origin (Required in production, defaults to http://localhost:4000 in dev)
# If incorrect in production, all client-side API requests and calculator previews will fail.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Canonical Public Site URL (Required in production, defaults to http://localhost:3000 in dev)
# Used for metadataBase, sitemap.xml, robots.txt, OpenGraph, and JSON-LD Schema.org structured data.
# If incorrect in production, canonical URLs, sitemaps, and search indexation will be corrupted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side internal API origin for RSC / server components / route handlers
# (Defaults to NEXT_PUBLIC_API_BASE_URL if omitted)
# In Docker/Kubernetes container networking, point to internal service, e.g. http://backend:4000
API_BASE_URL_INTERNAL=http://localhost:4000

# Shared secret with the backend (same variable there, 32+ characters). On Vercel, src/proxy.ts
# forwards each visitor's IP to the API with it so rate limits are per visitor.
# API_PROXY_SECRET=

# WhatsApp Contact Number for click-to-chat copy dispatch
NEXT_PUBLIC_WHATSAPP_NUMBER=919488440123
